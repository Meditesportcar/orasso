# Modèle de /etc/orasso/dev.env sur le VPS (root, 600). Jamais commité avec de vraies valeurs.
# remote-deploy.sh crée ce fichier au premier déploiement et génère les secrets sur le serveur.
# Il sert deux fois : variables de compose (POSTGRES_PASSWORD) et environnement de l'API.

# Base (conteneur orasso-db) ; l'API reçoit DATABASE_URL construite par compose.yml.
POSTGRES_PASSWORD=<généré : openssl rand -hex 24>

# API
NODE_ENV=production
PUBLIC_URL=https://dev.orasso.fr
BETTER_AUTH_SECRET=<généré : openssl rand -hex 32>

# Connexion Google / Apple : inactives tant que vides.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# Erreurs vers GlitchTip (compatible Sentry) : vide = désactivé. Projet GlitchTip à créer plus tard.
SENTRY_DSN=
SENTRY_ENVIRONMENT=dev

# 1 = charger le seed de démonstration à chaque déploiement (si la commande db:seed existe ; le seed est idempotent).
SEED_DEMO=1

# --- Ajouts du lot 05 (API des candidatures) ---
# Mot de passe des comptes de démonstration du seed (damien@orasso.local est super admin) : obligatoire en
# production, le seed refuse de tourner sans lui.
SEED_PASSWORD=<généré : openssl rand -hex 12>
# E-mails : « journal » = console de l'API + table email_outbox (pas d'envoi réel) ; « brevo » quand la clé existera.
MAIL_TRANSPORT=journal
MAIL_FROM=Orasso <contact@orasso.fr>
BREVO_API_KEY=
# Expo Push : facultatif (jeton d'accès du compte Expo, renforce la sécurité des envois).
EXPO_ACCESS_TOKEN=
# Photos : UPLOADS_DIR est fixé par compose.yml (/data/uploads). Ne jamais mettre DEV_SKIP_2FA ici :
# l'API refuse de démarrer avec DEV_SKIP_2FA=true en production.

# --- Ajouts du lot 06 (QR signés, jour J, points) ---
# Clé privée Ed25519 des QR d'inscription (obligatoire en production : l'API refuse de démarrer sans elle).
# La clé privée est une graine de 32 octets aléatoires en base64, à générer sur le serveur sans l'afficher :
#   printf 'QR_SIGNING_KEYS=[{"kid":1,"privateKey":"%s"}]\nQR_SIGNING_ACTIVE_KID=1\n' "$(openssl rand -base64 32)" \
#     | sudo tee -a /etc/orasso/dev.env > /dev/null
# (équivalent depuis le dépôt : pnpm --filter @orasso/api keys:generate). Ne jamais changer la clé d'un kid existant
# (tous les QR émis deviendraient invalides et l'API refuse de démarrer) : pour une rotation, ajouter une clé à la
# liste (kid 2) et changer QR_SIGNING_ACTIVE_KID.
QR_SIGNING_KEYS=<généré : [{"kid":1,"privateKey":"<openssl rand -base64 32>"}]>
QR_SIGNING_ACTIVE_KID=1
