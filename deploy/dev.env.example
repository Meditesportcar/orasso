# Modèle de /etc/orasso/dev.env sur le VPS (root, 600). Jamais commité avec de vraies valeurs.
# remote-deploy.sh crée ce fichier au premier déploiement et génère les secrets sur le serveur.
# Il sert deux fois : variables de compose (POSTGRES_PASSWORD) et environnement de l'API.

# Base (conteneur orasso-db) ; l'API reçoit DATABASE_URL construite par compose.yml.
POSTGRES_PASSWORD=<généré : openssl rand -hex 24>

# API
NODE_ENV=production
PUBLIC_URL=https://dev.orasso.fr
BETTER_AUTH_SECRET=<généré : openssl rand -hex 32>

# Connexion Google / Apple : inactives tant que vides.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# Erreurs vers GlitchTip (compatible Sentry) : vide = désactivé. Projet GlitchTip à créer plus tard.
SENTRY_DSN=
SENTRY_ENVIRONMENT=dev

# 1 = charger le seed de démonstration à chaque déploiement (si la commande db:seed existe ; le seed est idempotent).
SEED_DEMO=1

# --- Ajouts du lot 05 (API des candidatures) ---
# Mot de passe des comptes de démonstration du seed (damien@orasso.local est super admin) : obligatoire en
# production, le seed refuse de tourner sans lui.
SEED_PASSWORD=<généré : openssl rand -hex 12>
# E-mails : « journal » = console de l'API + table email_outbox (pas d'envoi réel) ; « brevo » quand la clé existera.
MAIL_TRANSPORT=journal
MAIL_FROM=Orasso <contact@orasso.fr>
BREVO_API_KEY=
# Brevo (lot 15) : envoi depuis un sous-domaine dédié (docs/01), réponses vers la boîte de contact. Exemple :
#   MAIL_FROM=Orasso <ne-pas-repondre@mail.orasso.fr>
#   MAIL_REPLY_TO=contact@orasso.fr
# MAIL_REPLY_TO vide = pas d'adresse de réponse (format « adresse » ou « Nom <adresse> »).
MAIL_REPLY_TO=

# Budget d'e-mails envoyés par Brevo par jour (heure de Paris), relecture du lot 20 : l'offre gratuite en permet 300.
# Les 50 derniers sont réservés au compte et à la sécurité (réinitialisation, vérification, alertes) ; au-delà, les autres
# e-mails ne partent pas (statut skipped_quota, la notification reste au Journal). Vide = 300.
MAIL_DAILY_BUDGET=
# Expo Push : facultatif (jeton d'accès du compte Expo, renforce la sécurité des envois).
EXPO_ACCESS_TOKEN=
# Photos : UPLOADS_DIR est fixé par compose.yml (/data/uploads). Ne jamais mettre DEV_SKIP_2FA ici :
# l'API refuse de démarrer avec DEV_SKIP_2FA=true en production.

# --- Ajouts du lot 06 (QR signés, jour J, points) ---
# Clé privée Ed25519 des QR d'inscription (obligatoire en production : l'API refuse de démarrer sans elle).
# La clé privée est une graine de 32 octets aléatoires en base64, à générer sur le serveur sans l'afficher :
#   printf 'QR_SIGNING_KEYS=[{"kid":1,"privateKey":"%s"}]\nQR_SIGNING_ACTIVE_KID=1\n' "$(openssl rand -base64 32)" \
#     | sudo tee -a /etc/orasso/dev.env > /dev/null
# (équivalent depuis le dépôt : pnpm --filter @orasso/api keys:generate). Ne jamais changer la clé d'un kid existant
# (tous les QR émis deviendraient invalides et l'API refuse de démarrer) : pour une rotation, ajouter une clé à la
# liste (kid 2) et changer QR_SIGNING_ACTIVE_KID. Le kid 0 est refusé en production (clé de démonstration du
# développement). Clé compromise : deploy/README.md, « Clés de signature des QR » (keys:revoke).
QR_SIGNING_KEYS=<généré : [{"kid":1,"privateKey":"<openssl rand -base64 32>"}]>
QR_SIGNING_ACTIVE_KID=1

# --- Ajouts du lot 13 (structures, événements, carte) ---
# Services publics gratuits et sans clé, valeurs par défaut du code : à ne renseigner que pour les changer.
# REGISTRY_API_URL : contrôle SIRET / RNA des structures. GEOCODER_URL : position des adresses (« off » = désactivé).
# Le VPS doit pouvoir sortir en HTTPS vers recherche-entreprises.api.gouv.fr et data.geopf.fr.
REGISTRY_API_URL=https://recherche-entreprises.api.gouv.fr
GEOCODER_URL=https://data.geopf.fr/geocodage

# --- Ajouts du lot 14 (pros, billetterie) ---
# Facultatives : vides = billetterie payante « bientôt ». Clés de TEST du compte Stripe d Orasso seulement :
# une clé sk_live_ fait refuser le démarrage de l API. Voir .env.example pour la configuration côté Stripe.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_CLIENT_ID=

# --- Ajouts du lot 15 (compte et sécurité, Sentry / GlitchTip) ---
# Erreurs : SENTRY_DSN (API, ci-dessus) ; VITE_SENTRY_DSN : projet GlitchTip du site (rendu serveur ; côté navigateur
# la valeur est lue à la construction de l'image, voir deploy/README.md). SENTRY_RELEASE est posé par compose.yml.
# Vides = rien n'est envoyé. L'appli lit EXPO_PUBLIC_SENTRY_DSN dans son profil EAS (eas.json), pas ici.
VITE_SENTRY_DSN=
# Les e-mails de réinitialisation, de vérification et d'alerte partent par MAIL_TRANSPORT (journal tant que Brevo
# n'est pas branché) : les liens pointent vers PUBLIC_URL. Les clés d'accès (passkeys) utilisent l'hôte de PUBLIC_URL
# comme identifiant : changer PUBLIC_URL rend les clés existantes inutilisables.

# --- Ajouts du lot 28 (météo) ---
# Fournisseur des prévisions : open-meteo (défaut, sans clé, gratuit pour l'usage NON commercial seulement : à quitter
# avant le 21/06/2027, AS1), met-norway (sans clé, usage commercial permis, User-Agent identifiant obligatoire) ou off.
# Pour basculer : changer la valeur puis redémarrer l'API (aucun changement de code ni de l'appli). Le VPS doit pouvoir
# sortir en HTTPS vers api.open-meteo.com et api.met.no. Les prévisions sont gardées en base (tâche toutes les 3 h).
WEATHER_PROVIDER=open-meteo
WEATHER_USER_AGENT=Orasso/0.1 contact@orasso.fr

# --- Ajouts du lot 30 (Accueil : lavage et carburant les plus proches) ---
# Lavage : Overpass / OpenStreetMap (service bénévole à usage raisonnable : un appel par département et par semaine).
# Carburant : prix ouverts de l'État (data.economie.gouv.fr), un appel par département et par heure. `off` désactive la
# source (le widget disparaît sans erreur, le cache déjà gardé reste servi). Instance Overpass propre : changer OVERPASS_URL.
# Le VPS doit pouvoir sortir en HTTPS vers overpass-api.de et data.economie.gouv.fr. Aucune clé, aucun compte.
OVERPASS_URL=https://overpass-api.de/api/interpreter
FUEL_API_URL=https://data.economie.gouv.fr/api/explore/v2.1/catalog/datasets/prix-des-carburants-en-france-flux-instantane-v2/records
EXTERNAL_USER_AGENT=Orasso/0.1 contact@orasso.fr
