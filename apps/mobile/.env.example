# Copier en apps/mobile/.env (jamais commité).
# Adresse de l'API vue depuis le téléphone : IP du PC sur le Wi-Fi en dev (ex. http://192.168.1.20:3001),
# https://dev.orasso.fr pour la version de test.
EXPO_PUBLIC_API_URL=http://localhost:3001

# Mode staff : clés publiques des QR épinglées au build (JSON, base64url), seules acceptées pour vérifier la liste et
# les QR hors ligne. Vide = clés apprises de /api/keys à la synchro. Pour un build vers https://dev.orasso.fr, recopier
# la clé de https://dev.orasso.fr/api/keys (jamais le kid 0, refusé de toute façon hors API locale).
# EXPO_PUBLIC_QR_TRUSTED_KEYS=[{"kid":1,"publicKey":"..."}]
EXPO_PUBLIC_QR_TRUSTED_KEYS=