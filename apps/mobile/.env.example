# Copier en apps/mobile/.env (jamais commité).
# Adresse de l'API vue depuis le téléphone : IP du PC sur le Wi-Fi en dev (ex. http://192.168.1.20:3001),
# https://dev.orasso.fr pour la version de test.
EXPO_PUBLIC_API_URL=http://localhost:3001
# Adresse du site (liens vers les pages web : créer une structure, clés d'accès, page d'une structure). Vide = même hôte
# que l'API, ce qui convient en ligne (https://dev.orasso.fr) ; en local, le site a son propre port (ex. http://localhost:5173).
EXPO_PUBLIC_SITE_URL=

# Mode staff : clés publiques des QR épinglées au build (JSON, clé Ed25519 de 32 octets en base64url), seules
# acceptées pour vérifier la liste et les QR hors ligne ; /api/keys peut seulement en retirer une révoquée.
# - API locale (http://localhost, réseau privé) : laisser vide, les clés (démo kid 0 comprise) viennent de /api/keys.
# - API en ligne : OBLIGATOIRE, sinon le mode staff refuse tout (« build sans clé de confiance »).
# Valeur pour https://dev.orasso.fr (kid 1) :
# EXPO_PUBLIC_QR_TRUSTED_KEYS=[{"kid":1,"publicKey":"m2FceWYTZw1CBjcfytn1FPL49U6RqVzBVkyfgC9jqjA"}]
EXPO_PUBLIC_QR_TRUSTED_KEYS=
# Erreurs de l'appli vers GlitchTip (lot 15) : vide = Sentry n'est pas initialisé.
EXPO_PUBLIC_SENTRY_DSN=
