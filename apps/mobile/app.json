{
  "expo": {
    "name": "Orasso",
    "slug": "orasso",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "orasso",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "fr.orasso.app",
      "supportsTablet": false
    },
    "android": {
      "package": "fr.orasso.app",
      "allowBackup": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#17191C"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "imageWidth": 160,
          "backgroundColor": "#17191C"
        }
      ],
      "expo-font",
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false
        }
      ],
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Orasso accède à tes photos pour illustrer ton véhicule.",
          "cameraPermission": "Orasso utilise l’appareil photo pour photographier ton véhicule et, si tu fais partie du staff, lire les QR d’accès à l’entrée des événements.",
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#E9B824"
        }
      ],
      "expo-sqlite",
      [
        "expo-camera",
        {
          "cameraPermission": "Orasso utilise l’appareil photo pour photographier ton véhicule et, si tu fais partie du staff, lire les QR d’accès à l’entrée des événements.",
          "recordAudioAndroid": false
        }
      ],
      "@sentry/react-native/expo",
      "@maplibre/maplibre-react-native",
      "expo-sharing",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Orasso utilise ta position seulement quand tu le demandes (« Utiliser ma position ») pour montrer les événements et les pros autour de toi et, si tu fais partie du staff, situer une alerte ou un incident. Elle n’est jamais enregistrée.",
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false,
          "motionUsagePermission": false,
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false,
          "isAndroidForegroundServiceEnabled": false,
          "isAndroidMotionActivityEnabled": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ae53f346-f41a-4871-a14c-35d330589656"
      }
    },
    "owner": "dams4889494"
  }
}
