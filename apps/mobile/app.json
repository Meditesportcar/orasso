{
  "expo": {
    "name": "Orasso",
    "slug": "orasso",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "orasso",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "fr.orasso.app",
      "supportsTablet": false
    },
    "android": {
      "package": "fr.orasso.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#17191C"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "imageWidth": 160,
          "backgroundColor": "#17191C"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
