{
  "expo": {
    "name": "Orasso",
    "slug": "orasso",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "orasso",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "fr.orasso.app",
      "supportsTablet": false
    },
    "android": {
      "package": "fr.orasso.app",
      "allowBackup": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#17191C"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "imageWidth": 160,
          "backgroundColor": "#17191C"
        }
      ],
      "expo-font",
      "expo-audio",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Orasso accède à tes photos pour illustrer ton véhicule.",
          "cameraPermission": "Orasso utilise l’appareil photo pour photographier ton véhicule."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#E9B824"
        }
      ],
      "expo-sqlite",
      [
        "expo-camera",
        {
          "cameraPermission": "Orasso utilise l’appareil photo pour lire les QR d’accès à l’entrée des événements.",
          "recordAudioAndroid": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
