{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": [
      "**",
      "!docs",
      "!identite",
      "!**/drizzle/meta",
      "!**/.react-router",
      "!**/.expo",
      "!apps/web/public",
      "!apps/mobile/assets",
      "!packages/design-system/src/web/assets",
      "!packages/design-system/src/web/fonts",
      "!packages/design-system/src/tokens.ts",
      "!packages/design-system/src/native/brandArt.ts",
      "!packages/design-system/src/web/tokens.css",
      "!packages/design-system/src/web/typography.css"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "javascript": {
    "formatter": { "quoteStyle": "double", "trailingCommas": "all", "semicolons": "always" }
  },
  "linter": {
    "enabled": true,
    "rules": { "preset": "recommended" }
  },
  "overrides": [
    {
      "includes": ["packages/design-system/src/web/motion.css"],
      "linter": { "rules": { "complexity": { "noImportantStyles": "off" } } }
    }
  ],
  "assist": { "actions": { "source": { "organizeImports": "on" } } }
}
