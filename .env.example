# Copier en .env (jamais commité) puis adapter.

# Base PostgreSQL. En local, `pnpm db:start` lance une base embarquée avec ces réglages.
# Un worktree = un port et un dossier différents.
DATABASE_URL=postgres://orasso:orasso@localhost:54329/orasso
DB_DATA_DIR=.data/pg

# API et site (en dev, le site relaie /api vers API_PORT)
API_PORT=3001
WEB_PORT=5173
# Adresse publique du site (même origine que l'API : /api). En dev, le site Vite proxifie /api.
PUBLIC_URL=http://localhost:5173
# Secret de Better Auth : au moins 32 caractères aléatoires (ex. `node -e "console.log(crypto.randomBytes(32).toString('base64url'))"`).
BETTER_AUTH_SECRET=change-me-change-me-change-me-change-me

# Connexion Google / Apple : désactivées tant que ces identifiants sont vides.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=


# Double authentification obligatoire des organisateurs et de l'administration : contournement en développement
# seulement (l'API refuse de démarrer avec true en production). Laisser false pour tester la vraie règle.
DEV_SKIP_2FA=true

# E-mails : « journal » (par défaut) écrit chaque e-mail dans DATA_DIR/mail et l'affiche en console ;
# « brevo » les envoie (clé requise).
MAIL_TRANSPORT=journal
MAIL_FROM=Orasso <contact@orasso.fr>
BREVO_API_KEY=
# Brevo (lot 15) : envoi depuis un sous-domaine dédié (docs/01), réponses vers la boîte de contact. Exemple :
#   MAIL_FROM=Orasso <ne-pas-repondre@mail.orasso.fr>
#   MAIL_REPLY_TO=contact@orasso.fr
# MAIL_REPLY_TO vide = pas d'adresse de réponse (format « adresse » ou « Nom <adresse> »).
MAIL_REPLY_TO=

# Budget d'e-mails envoyés par Brevo par jour (heure de Paris), relecture du lot 20 : l'offre gratuite en permet 300.
# Les 50 derniers sont réservés au compte et à la sécurité (réinitialisation, vérification, alertes) ; au-delà, les autres
# e-mails ne partent pas (statut skipped_quota, la notification reste au Journal). Vide = 300.
MAIL_DAILY_BUDGET=

# Fichiers locaux (photos, e-mails du journal), relatif à la racine du dépôt.
DATA_DIR=.data

# Mot de passe des comptes de démonstration créés par `pnpm db:seed` (damien@orasso.local, kenji@orasso.local…).
SEED_PASSWORD=orasso-demo-2026

# Dossier des photos envoyées (pilote disque). Vide = DATA_DIR/storage. Sur le VPS : /data/uploads.
UPLOADS_DIR=

# Clés Ed25519 des QR d'inscription : `pnpm --filter @orasso/api keys:generate` affiche les deux lignes à coller ici.
# Vides en développement = clé de démonstration publique (kid 0) ; obligatoires en production.
QR_SIGNING_KEYS=
QR_SIGNING_ACTIVE_KID=

# Origines web autorisées à appeler l'API depuis un autre hôte (CORS), séparées par des virgules : recette de l'appli
# dans un navigateur (`expo start --web`, ex. http://localhost:8081). Vide en production : site et API sur le même hôte.
# Téléphone en développement : ajouter aussi l'adresse de l'API vue par le téléphone (ex. http://192.168.1.20:3001),
# envoyée en en-tête Origin par l'appli sur /api/auth/* (étape « code » de la double authentification).
CORS_ORIGINS=

# Contrôle SIRET / RNA des structures (API Recherche d'entreprises de l'État, publique, sans clé) et géocodage des
# adresses (Géoplateforme de l'IGN, sans clé). Valeurs par défaut ci-dessous ; GEOCODER_URL=off désactive le géocodage.
REGISTRY_API_URL=https://recherche-entreprises.api.gouv.fr
GEOCODER_URL=https://data.geopf.fr/geocodage

# Billetterie payante en mode présentation (lot 14) : Stripe Connect, compte Orasso en MODE TEST uniquement. Les trois
# variables vides = billetterie payante affichée « bientôt », sans erreur. Une clé sk_live_ est refusée (l API ne démarre pas).
# STRIPE_SECRET_KEY : clé secrète de test (sk_test_…). STRIPE_WEBHOOK_SECRET : secret du point de terminaison (whsec_…)
# qui pointe vers <PUBLIC_URL>/api/stripe/webhook (événements Connect). STRIPE_CONNECT_CLIENT_ID : identifiant de
# l application Connect (ca_…), URI de redirection <PUBLIC_URL>/api/stripe/connect/callback.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_CLIENT_ID=

# Erreurs vers GlitchTip (compatible Sentry), lot 15 : vides = rien n'est initialisé ni envoyé.
# SENTRY_DSN : API. VITE_SENTRY_DSN : site (navigateur, lu à la construction, et rendu serveur). Appli : EXPO_PUBLIC_SENTRY_DSN
# dans apps/mobile/.env. Les rapports ne contiennent jamais plaque, téléphone, e-mail ni corps de requête.
SENTRY_DSN=
SENTRY_ENVIRONMENT=
VITE_SENTRY_DSN=

# Météo (lot 28) : fournisseur des prévisions. open-meteo (défaut, gratuit pour l'usage NON commercial seulement, à
# quitter avant le 21/06/2027), met-norway (usage commercial permis), off (désactivée). Changer la valeur et redémarrer
# l'API suffit. WEATHER_USER_AGENT : identifiant envoyé aux fournisseurs (obligatoire et réel pour MET Norway).
WEATHER_PROVIDER=open-meteo
WEATHER_USER_AGENT=Orasso/0.1 contact@orasso.fr

# --- Ajouts du lot 30 (Accueil : lavage et carburant les plus proches) ---
# Lavage : Overpass / OpenStreetMap (service bénévole à usage raisonnable : un appel par département et par semaine).
# Carburant : prix ouverts de l'État (data.economie.gouv.fr), un appel par département et par heure. `off` désactive la
# source (le widget disparaît sans erreur, le cache déjà gardé reste servi). Instance Overpass propre : changer OVERPASS_URL.
# Le VPS doit pouvoir sortir en HTTPS vers overpass-api.de et data.economie.gouv.fr. Aucune clé, aucun compte.
OVERPASS_URL=https://overpass-api.de/api/interpreter
FUEL_API_URL=https://data.economie.gouv.fr/api/explore/v2.1/catalog/datasets/prix-des-carburants-en-france-flux-instantane-v2/records
EXTERNAL_USER_AGENT=Orasso/0.1 contact@orasso.fr

# --- Ajouts du lot 34a (horloge simulée, développement seulement) ---
# DEV_CLOCK=on : permet d'avancer le temps d'Orasso (page /admin/horloge, `pnpm dev:clock`) pour voir verrouillage, points,
# malus, bilan sans attendre. Le décalage est gardé en base (table dev_clock). L'API refuse de démarrer avec DEV_CLOCK=on en
# production ; sans elle, ni route, ni page, ni en-tête. Le site doit la voir aussi (même .env en local).
DEV_CLOCK=on
# --- Ajouts du lot 33 (administration : newsletter) ---
# NEWSLETTER_FROM : expéditeur de la newsletter (« Orasso <newsletter@mail.orasso.fr> ») ; vide = MAIL_FROM.
# UNSUBSCRIBE_SECRET : secret des liens de désinscription (HMAC), 32 caractères au moins. Obligatoire en production ;
# vide en développement = dérivé de BETTER_AUTH_SECRET.
NEWSLETTER_FROM=
UNSUBSCRIBE_SECRET=
