{
  "name": "@orasso/design-system",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./web": "./src/web/index.ts",
    "./web/styles.css": "./src/web/styles.css",
    "./web/tokens.css": "./src/web/tokens.css",
    "./native": "./src/native/index.ts",
    "./map/web": "./src/map/web.ts",
    "./map/map.css": "./src/map/map.css"
  },
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "generate": "node scripts/generate-tokens.mjs && node scripts/generate-native-brand.mjs",
    "build": "node scripts/generate-tokens.mjs && node scripts/generate-native-brand.mjs && tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "pretest": "node scripts/generate-tokens.mjs && node scripts/generate-native-brand.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@orasso/shared": "workspace:*"
  },
  "peerDependencies": {
    "expo-audio": "*",
    "expo-font": "*",
    "react": "19.2.3",
    "react-native": "*",
    "react-native-reanimated": "*",
    "react-native-svg": "*"
  },
  "devDependencies": {
    "@maplibre/maplibre-gl-style-spec": "^26.4.4",
    "@types/react": "~19.2.18",
    "@types/react-dom": "~19.2.7",
    "maplibre-gl": "^6.14.0",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "peerDependenciesMeta": {
    "react-native": {
      "optional": true
    },
    "react-native-svg": {
      "optional": true
    },
    "react-native-reanimated": {
      "optional": true
    },
    "expo-font": {
      "optional": true
    },
    "expo-audio": {
      "optional": true
    }
  }
}
