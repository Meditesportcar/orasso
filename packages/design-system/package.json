{
  "name": "@orasso/design-system",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./web": "./src/web/index.ts",
    "./web/styles.css": "./src/web/styles.css",
    "./web/tokens.css": "./src/web/tokens.css"
  },
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "generate": "node scripts/generate-tokens.mjs",
    "build": "node scripts/generate-tokens.mjs && tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "pretest": "node scripts/generate-tokens.mjs",
    "test": "vitest run"
  },
  "peerDependencies": {
    "react": "19.2.3"
  },
  "devDependencies": {
    "@types/react": "~19.2.18",
    "@types/react-dom": "~19.2.7",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  }
}
